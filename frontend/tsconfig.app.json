{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "paths": {
      "@/*": ["./src/*"],
      /* `[ADDED 2026-08-22]` @splidejs/react-splide ships declarations
         (dist/types/index.d.ts, named by its top-level "types" field) but its
         "exports" map has no "types" condition. Under moduleResolution "bundler" the
         exports map wins, the "types" field is never read, and tsc reports the module
         as implicitly any (TS7016) — while Vite resolves it fine. Pointing at the real
         declarations keeps full type safety instead of shimming the module as any. */
      "@splidejs/react-splide": ["./node_modules/@splidejs/react-splide/dist/types/index.d.ts"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  /* Tests live in tsconfig.test.json: they need Node + Vitest types that app code must
     not be given. Excluding them here is what keeps that separation real. */
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/__tests__/**/*", "src/test"]
}
