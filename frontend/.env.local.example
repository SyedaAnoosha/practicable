VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_API_BASE_URL=http://localhost:8000

# Address behind every "contact us" link (src/lib/support.ts). Falls back to the
# brand domain if unset — never a personal inbox.
VITE_SUPPORT_EMAIL=support@yourdomain

# week2_plan.md Phase 5 / W2-R8. src/lib/analytics.ts no-ops (no error, nothing
# loaded) if VITE_POSTHOG_KEY is unset or the visitor has Do Not Track on — safe to
# leave blank in local dev. Same project key the backend's POSTHOG_API_KEY uses.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
