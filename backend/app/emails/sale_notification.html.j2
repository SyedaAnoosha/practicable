{% extends "base.html.j2" %}
{% block title %}New sale: {{ product_name }}{% endblock %}
{% block preheader %}{{ buyer_email }} just bought {{ product_name }} — {{ amount_display }}.{% endblock %}
{% block content %}
<h1 style="font-family:Georgia,'Times New Roman',serif; font-size:22px; line-height:1.3; color:#1C1712; margin:0 0 16px;">You made a sale</h1>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #E6DFD0; border-radius:6px;">
  <tr>
    <td style="padding:16px 20px; border-bottom:1px solid #E6DFD0; font-family:-apple-system,'Segoe UI',Arial,sans-serif; font-size:13px; color:#6E675A;">Order</td>
    <td align="right" style="padding:16px 20px; border-bottom:1px solid #E6DFD0; font-family:'Courier New',Courier,monospace; font-size:13px; color:#1C1712;">{{ order_id }}</td>
  </tr>
  <tr>
    <td style="padding:16px 20px; border-bottom:1px solid #E6DFD0; font-family:-apple-system,'Segoe UI',Arial,sans-serif; font-size:13px; color:#6E675A;">Buyer</td>
    <td align="right" style="padding:16px 20px; border-bottom:1px solid #E6DFD0; font-family:-apple-system,'Segoe UI',Arial,sans-serif; font-size:13px; color:#1C1712;">{{ buyer_email }}</td>
  </tr>
  <tr>
    <td style="padding:16px 20px; border-bottom:1px solid #E6DFD0; font-family:-apple-system,'Segoe UI',Arial,sans-serif; font-size:13px; color:#6E675A;">Product</td>
    <td align="right" style="padding:16px 20px; border-bottom:1px solid #E6DFD0; font-family:-apple-system,'Segoe UI',Arial,sans-serif; font-size:13px; color:#1C1712;">{{ product_name }}</td>
  </tr>
  <tr>
    <td style="padding:16px 20px; font-family:-apple-system,'Segoe UI',Arial,sans-serif; font-size:14px; font-weight:bold; color:#1C1712;">Amount</td>
    <td align="right" style="padding:16px 20px; font-family:'Courier New',Courier,monospace; font-size:16px; font-weight:bold; color:#7C5C14;">{{ amount_display }}</td>
  </tr>
</table>
{% endblock %}
