{% extends "base.html.j2" %}
{% import "_button.html.j2" as btn %}
{% block title %}Welcome to Practicable{% endblock %}
{% block preheader %}You now have access to {{ product_name }} — here's where to find it.{% endblock %}
{% block content %}
<h1 style="font-family:Georgia,'Times New Roman',serif; font-size:22px; line-height:1.3; color:#1C1712; margin:0 0 16px;">Welcome to Practicable</h1>
<p style="margin:0 0 16px;">Thanks for buying <strong>{{ product_name }}</strong>. You now have full access — no separate sign-up, no additional step.</p>
{% if content_items %}
<p style="margin:0 0 8px; font-weight:bold;">What you have access to:</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 16px;">
  {% for item in content_items %}
  <tr>
    <td style="padding:4px 0; font-family:Georgia,'Times New Roman',serif; font-size:16px; color:#1C1712;">– {{ item.label }}</td>
  </tr>
  {% endfor %}
</table>
{% endif %}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
  <tr><td>{{ btn.button(primary_link, "Go to your library") }}</td></tr>
</table>
<p style="margin:0 0 16px;">Practicable is written and maintained by Effective Risk Management — real risk questions, answered plainly, not templated advice.</p>
<p style="margin:0;">If you have a question about your purchase, reply to this email.</p>
{% endblock %}
