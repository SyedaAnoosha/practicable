{% extends "base.html.j2" %}
{% import "_button.html.j2" as btn %}
{% block title %}Your Certificate{% endblock %}
{% block preheader %}You've completed {{ course_title }} — your certificate is ready.{% endblock %}
{% block content %}
<h1 style="font-family:Georgia,'Times New Roman',serif; font-size:22px; line-height:1.3; color:#1C1712; margin:0 0 16px;">Congratulations!</h1>
<p style="margin:0 0 16px;">You've completed <strong>{{ course_title }}</strong> — your certificate of completion is ready.</p>
<p style="margin:0 0 8px;">Your certificate includes:</p>
<ul style="margin:0 0 16px; padding-left:20px;">
  <li style="padding:4px 0; font-family:Georgia,'Times New Roman',serif; font-size:16px; color:#1C1712;">Your name and the course title</li>
  <li style="padding:4px 0; font-family:Georgia,'Times New Roman',serif; font-size:16px; color:#1C1712;">A unique verification code anyone can check</li>
</ul>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
  <tr><td>{{ btn.button(download_url, "Download your certificate") }}</td></tr>
</table>
<p style="margin:0 0 16px;">You can always re-download your certificate from your dashboard.</p>
<p style="margin:0;">If you have a question, reply to this email.</p>
{% endblock %}
