{% extends "base.html.j2" %}
{% block title %}Your refund for order {{ order_id }}{% endblock %}
{% block preheader %}{{ amount_display }} refunded for order {{ order_id }}.{% endblock %}
{% block content %}
<h1 style="font-family:Georgia,'Times New Roman',serif; font-size:22px; line-height:1.3; color:#1C1712; margin:0 0 16px;">Your refund is confirmed</h1>
<p style="margin:0 0 24px;">We've refunded order <span style="font-family:'Courier New',Courier,monospace;">{{ order_id }}</span>.</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #E6DFD0; border-radius:6px; margin:0 0 24px;">
  <tr>
    <td style="padding:16px 20px; border-bottom:1px solid #E6DFD0;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="font-family:-apple-system,'Segoe UI',Arial,sans-serif; font-size:14px; font-weight:bold; color:#1C1712;">Amount refunded</td>
          <td align="right" style="font-family:'Courier New',Courier,monospace; font-size:16px; font-weight:bold; color:#7C5C14;">{{ amount_display }}</td>
        </tr>
      </table>
    </td>
  </tr>
  <tr>
    <td style="padding:16px 20px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="font-family:-apple-system,'Segoe UI',Arial,sans-serif; font-size:13px; color:#6E675A;">Expected in your account</td>
          <td align="right" style="font-family:-apple-system,'Segoe UI',Arial,sans-serif; font-size:13px; color:#1C1712;">{{ refund_eta }}</td>
        </tr>
      </table>
    </td>
  </tr>
</table>
{% if removed_items %}
<p style="margin:0 0 8px; font-weight:bold;">Access removed:</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
  {% for label in removed_items %}
  <tr>
    <td style="padding:4px 0; font-family:Georgia,'Times New Roman',serif; font-size:16px; color:#1C1712;">– {{ label }}</td>
  </tr>
  {% endfor %}
</table>
{% endif %}
<p style="margin:0;">If anything here looks wrong, reply to this email and we'll sort it out.</p>
{% endblock %}
