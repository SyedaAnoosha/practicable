{% extends "base.html.j2" %}
{% import "_button.html.j2" as btn %}
{% block title %}Reset your Practicable password{% endblock %}
{% block preheader %}Use this link to reset your password. It expires in {{ expires_in }}.{% endblock %}
{% block content %}
<h1 style="font-family:Georgia,'Times New Roman',serif; font-size:22px; line-height:1.3; color:#1C1712; margin:0 0 16px;">Reset your password</h1>
<p style="margin:0 0 24px;">Use the link below to choose a new password. It expires in {{ expires_in }}.</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
  <tr><td>{{ btn.button(reset_url, "Reset your password") }}</td></tr>
</table>
<p style="margin:0;">If you did not request this, you can ignore this email — your password will not change unless you open the link above and choose a new one.</p>
{% endblock %}
