{% extends "base.html.j2" %}
{% import "_button.html.j2" as btn %}
{% block title %}Your link to Practicable{% endblock %}
{% block preheader %}Here's your link — bookmark it, it doesn't expire.{% endblock %}
{% block content %}
<h1 style="font-family:Georgia,'Times New Roman',serif; font-size:22px; line-height:1.3; color:#1C1712; margin:0 0 16px;">Here's your link</h1>
<p style="margin:0 0 24px;">You asked for this, so here it is — a permanent link, worth bookmarking:</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
  <tr><td>{{ btn.button(primary_link, "Open it now") }}</td></tr>
</table>
<p style="margin:0;">There's more on the platform than this — paid templates and full courses, all one-time purchases with lifetime access, no subscription. This link stays free either way.</p>
{% endblock %}
