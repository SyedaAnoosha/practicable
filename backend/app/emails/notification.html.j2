{% extends "base.html.j2" %}
{% import "_button.html.j2" as btn %}
{% block title %}{{ subject }}{% endblock %}
{% block preheader %}{{ subject }}{% endblock %}
{% block content %}
<h1 style="font-family:Georgia,'Times New Roman',serif; font-size:22px; line-height:1.3; color:#1C1712; margin:0 0 16px;">{{ subject }}</h1>
<p style="margin:0 0 16px;">{{ message }}</p>

{% if action_url %}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
  <tr><td>{{ btn.button(action_url, "View details") }}</td></tr>
</table>
{% endif %}

<p style="margin:0;">Thanks,<br>The Practicable team</p>
{% endblock %}
