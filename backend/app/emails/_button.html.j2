{# Bulletproof CTA button — DESIGN.md §20.7: a table cell with a background colour,
   never an <a> with a background image. Renders correctly with images blocked, and in
   Outlook's Word rendering engine, because nothing here depends on an image loading. #}
{% macro button(url, label) -%}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 auto;">
  <tr>
    <td align="center" bgcolor="#10213E" style="border-radius:6px; background-color:#10213E;">
      <a href="{{ url }}" target="_blank"
         style="display:inline-block; padding:14px 28px; font-family:-apple-system,'Segoe UI',Arial,sans-serif; font-size:16px; font-weight:600; color:#F7F2E9; text-decoration:none; border-radius:6px;">
        {{ label }}
      </a>
    </td>
  </tr>
</table>
{%- endmacro %}
