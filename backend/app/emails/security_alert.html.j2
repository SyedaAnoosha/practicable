{% extends "base.html.j2" %}
{% block title %}Your account details changed{% endblock %}
{% block preheader %}Your account details were updated. If this wasn't you, contact us immediately.{% endblock %}
{% block content %}
<h1 style="font-family:Georgia,'Times New Roman',serif; font-size:22px; line-height:1.3; color:#1C1712; margin:0 0 16px;">Your account details changed</h1>
<p style="margin:0 0 16px;">We're letting you know that your account details were recently updated.</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #E6DFD0; border-radius:6px; margin:0 0 24px;">
  <tr>
    <td style="padding:16px 20px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="font-family:-apple-system,'Segoe UI',Arial,sans-serif; font-size:13px; color:#6E675A;">Action</td>
          <td align="right" style="font-family:-apple-system,'Segoe UI',Arial,sans-serif; font-size:14px; font-weight:bold; color:#1C1712;">{{ action }}</td>
        </tr>
      </table>
    </td>
  </tr>
  {% if details %}
  <tr>
    <td style="padding:16px 20px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="font-family:-apple-system,'Segoe UI',Arial,sans-serif; font-size:13px; color:#6E675A;">Details</td>
          <td align="right" style="font-family:-apple-system,'Segoe UI',Arial,sans-serif; font-size:13px; color:#1C1712;">{{ details }}</td>
        </tr>
      </table>
    </td>
  </tr>
  {% endif %}
</table>
<p style="margin:0 0 24px; font-size:14px; color:#6E675A;">If you didn't make this change, please contact us immediately so we can secure your account.</p>
<p style="margin:0;">Thanks,<br>The Practicable team</p>
{% endblock %}
