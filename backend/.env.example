# Database (Supabase project settings -> Database -> Connection string -> URI)
# NOT the same as SUPABASE_URL below. Use the pooler host's SESSION mode port (5432),
# not Transaction mode (6543) — asyncpg's SQLAlchemy dialect always issues named
# prepared statements, which Transaction-mode pgbouncer's connection-swapping breaks
# (see app/db/session.py's comment). Session mode is correct for a persistent server
# like this one; Transaction mode is for serverless/edge functions.
DATABASE_URL=postgresql://postgres.your_project_ref:your_password@your-pooler-host.pooler.supabase.com:5432/postgres

# Supabase
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
SUPABASE_JWT_AUDIENCE=authenticated

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Mux
MUX_TOKEN_ID=your_mux_token_id
MUX_TOKEN_SECRET=your_mux_token_secret

# Supabase Storage (S3-compatible API — Project Settings -> Storage -> S3 Connection)
SUPABASE_STORAGE_S3_ENDPOINT=https://your_project_ref.supabase.co/storage/v1/s3
SUPABASE_STORAGE_REGION=your_project_region
SUPABASE_STORAGE_ACCESS_KEY_ID=your_storage_access_key_id
SUPABASE_STORAGE_SECRET_ACCESS_KEY=your_storage_secret_access_key
SUPABASE_STORAGE_BUCKET_NAME=your_storage_bucket_name

# Email — Gmail SMTP is the FIRST transport tried (docs/gmail.md). Requires 2-Step
# Verification on the Google account, then an App Password from
# myaccount.google.com/apppasswords. Paste the 16 characters with the spaces REMOVED.
# Leave both blank to skip this tier entirely and fall through to Mailjet.
# Note: Gmail forces the From address to GMAIL_USER on personal accounts — a custom
# sender address is not possible on this transport, only a display name.
GMAIL_USER=your_gmail_address
GMAIL_APP_PASSWORD=your_16_char_app_password

# Email — Resend, active in sandbox mode (docs/email.md): no domain, no phone
# verification, but can only deliver to the address the Resend account is registered
# under, not real buyers yet.
RESEND_API_KEY=your_resend_api_key

# Brevo — the upgrade path once its one-time phone verification is done (verifies a
# sender *email*, not a domain, and has no sandbox recipient restriction). Settings ->
# SMTP & API -> API Keys; brevo_sender_email must be verified first (Senders, Domains
# & Dedicated IPs -> Senders -> Add a sender -> click the confirmation link it emails).
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender_email
BREVO_SENDER_NAME=Practicable

# CORS
ALLOWED_ORIGIN=http://localhost:5173
