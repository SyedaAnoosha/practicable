# Database (Supabase project settings -> Database -> Connection string -> URI)
# NOT the same as SUPABASE_URL below. Use the pooler host's SESSION mode port (5432),
# not Transaction mode (6543) — asyncpg's SQLAlchemy dialect always issues named
# prepared statements, which Transaction-mode pgbouncer's connection-swapping breaks
# (see app/db/session.py's comment). Session mode is correct for a persistent server
# like this one; Transaction mode is for serverless/edge functions.
DATABASE_URL=postgresql://postgres.your_project_ref:your_password@your-pooler-host.pooler.supabase.com:5432/postgres

# Supabase
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
SUPABASE_JWT_AUDIENCE=authenticated

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Mux
MUX_TOKEN_ID=your_mux_token_id
MUX_TOKEN_SECRET=your_mux_token_secret

# Supabase Storage (S3-compatible API — Project Settings -> Storage -> S3 Connection)
SUPABASE_STORAGE_S3_ENDPOINT=https://your_project_ref.supabase.co/storage/v1/s3
SUPABASE_STORAGE_REGION=your_project_region
SUPABASE_STORAGE_ACCESS_KEY_ID=your_storage_access_key_id
SUPABASE_STORAGE_SECRET_ACCESS_KEY=your_storage_secret_access_key
SUPABASE_STORAGE_BUCKET_NAME=your_storage_bucket_name

# ── Email — Resend only, sandbox mode [OWNER-DECIDED 2026-08-12] ───────────────
# The Gmail, Mailjet and Brevo transports were removed. Gmail and Brevo are SMTP and
# cannot work on Render at all (outbound 587 is blocked — see docs/gmail.md §8);
# Mailjet was working over HTTPS and was removed by choice. Any leftover GMAIL_*,
# MAILJET_* or BREVO_* keys here are inert.
#
# IMPORTANT: Resend's sandbox sender (onboarding@resend.dev) can only deliver to the
# one address the Resend account is registered under. While that is true, REAL BUYERS
# RECEIVE NOTHING — their receipt is redirected to OWNER_NOTIFICATION_EMAIL and clearly
# labelled as undelivered. Reverse this before taking real money: verify a domain at
# resend.com/domains, or restore the Mailjet tier from git history.
RESEND_API_KEY=your_resend_api_key

# The owner/admin inbox. Load-bearing for ALL email right now, not just sale alerts:
# buyer receipts are redirected here too. This MUST equal the address the Resend
# account is registered under, or every send returns 403.
# Never point this at a customer address — sale notifications quote the buyer's email
# and what they paid.
OWNER_NOTIFICATION_EMAIL=owner_inbox_address

# CORS
ALLOWED_ORIGIN=http://localhost:5173
