# Database (Supabase project settings -> Database -> Connection string -> URI)
# NOT the same as SUPABASE_URL below. Use the pooler host's SESSION mode port (5432),
# not Transaction mode (6543) — asyncpg's SQLAlchemy dialect always issues named
# prepared statements, which Transaction-mode pgbouncer's connection-swapping breaks
# (see app/db/session.py's comment). Session mode is correct for a persistent server
# like this one; Transaction mode is for serverless/edge functions.
DATABASE_URL=postgresql://postgres.your_project_ref:your_password@your-pooler-host.pooler.supabase.com:5432/postgres

# Supabase
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
SUPABASE_JWT_AUDIENCE=authenticated

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Mux
MUX_TOKEN_ID=your_mux_token_id
MUX_TOKEN_SECRET=your_mux_token_secret

# Supabase Storage (S3-compatible API — Project Settings -> Storage -> S3 Connection)
SUPABASE_STORAGE_S3_ENDPOINT=https://your_project_ref.supabase.co/storage/v1/s3
SUPABASE_STORAGE_REGION=your_project_region
SUPABASE_STORAGE_ACCESS_KEY_ID=your_storage_access_key_id
SUPABASE_STORAGE_SECRET_ACCESS_KEY=your_storage_secret_access_key
SUPABASE_STORAGE_BUCKET_NAME=your_storage_bucket_name

# ── Email — Mailjet only [OWNER-DECIDED 2026-08-15, week3_plan.md W3-R1] ───────
# Restored, not rebuilt: Mailjet was working over REST when it was removed by choice on
# 2026-08-12, not because it failed (docs/email.md, docs/gmail.md §9). It reaches an
# arbitrary real recipient directly — no domain, no sandbox redirect — and survives
# Render's outbound-port-587 block that makes Gmail/Brevo SMTP structurally impossible
# on this host. Any leftover GMAIL_*, BREVO_* or RESEND_* keys here are inert; delete
# them rather than leave them ignored.
MAILJET_API_KEY=your_mailjet_api_key
MAILJET_SECRET_KEY=your_mailjet_secret_key
# Must be verified as a sender in the Mailjet dashboard (Senders, Domains & Dedicated
# IPs → Senders → click the confirmation link Mailjet emails to this address) before any
# send from it will succeed.
MAILJET_SENDER_EMAIL=your_verified_sender_address
MAILJET_SENDER_NAME=Practicable

# The owner/admin inbox — sale alerts, and where a send whose real recipient can't be
# reached is logged against. Never point this at a customer address — sale
# notifications quote the buyer's email and what they paid.
OWNER_NOTIFICATION_EMAIL=owner_inbox_address

# The deployed frontend origin, for absolute links inside emails (a mail client has no
# notion of a relative URL). Set to the real Vercel URL in Render's environment — same
# treatment as ALLOWED_ORIGIN below.
FRONTEND_URL=http://localhost:5173

# CORS
ALLOWED_ORIGIN=http://localhost:5173

# week2_plan.md Phase 5 / W2-R8 / BACKEND.md §6.5. app/integrations/posthog_client.py
# no-ops (no error) if this is unset — safe to leave blank in local dev. Same project
# key the frontend's VITE_POSTHOG_KEY uses.
POSTHOG_API_KEY=your_posthog_project_api_key
POSTHOG_HOST=https://us.i.posthog.com
